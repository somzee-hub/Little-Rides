<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Where orders and enquiries come from -->
    <record id="utm_source_whatsapp_group" model="utm.source"><field name="name">WhatsApp Order Group</field></record>
    <record id="utm_source_indiamart" model="utm.source"><field name="name">IndiaMART</field></record>
    <record id="utm_source_shop" model="utm.source"><field name="name">Shop Walk-in</field></record>
    <record id="utm_source_referral" model="utm.source"><field name="name">Dealer Referral</field></record>
    <record id="utm_source_amazon" model="utm.source"><field name="name">Amazon</field></record>
    <record id="utm_source_flipkart" model="utm.source"><field name="name">Flipkart</field></record>

    <!-- Customer rate categories: A, B, C on MRP, plus online MRP -->
    <record id="pricelist_cat_a" model="product.pricelist">
        <field name="name">Rate A: Distributor (MRP less 35%)</field>
        <field name="sequence">1</field>
        <field name="item_ids" eval="[(0, 0, {'applied_on': '3_global', 'compute_price': 'percentage', 'percent_price': 35.0})]"/>
    </record>
    <record id="pricelist_cat_b" model="product.pricelist">
        <field name="name">Rate B: Dealer (MRP less 28%)</field>
        <field name="sequence">2</field>
        <field name="item_ids" eval="[(0, 0, {'applied_on': '3_global', 'compute_price': 'percentage', 'percent_price': 28.0})]"/>
    </record>
    <record id="pricelist_cat_c" model="product.pricelist">
        <field name="name">Rate C: Retailer (MRP less 20%)</field>
        <field name="sequence">3</field>
        <field name="item_ids" eval="[(0, 0, {'applied_on': '3_global', 'compute_price': 'percentage', 'percent_price': 20.0})]"/>
    </record>
    <record id="pricelist_online" model="product.pricelist">
        <field name="name">Online MRP (Amazon, Flipkart)</field>
        <field name="sequence">4</field>
    </record>

    <!-- Daily alert: bought-out parts whose stock will not last the supplier lead time -->
    <record id="cron_component_cover" model="ir.cron">
        <field name="name">Little Rides: component cover alert</field>
        <field name="model_id" ref="product.model_product_product"/>
        <field name="state">code</field>
        <field name="code">model._cron_lr_component_alert()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active" eval="True"/>
    </record>
</odoo>
