<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_littlerides" model="ir.module.category">
        <field name="name">Little Rides Controls</field>
        <field name="sequence">90</field>
    </record>

    <!-- Stock maker-checker: makers count and record, checkers apply adjustments and scrap -->
    <record id="privilege_lr_stock" model="res.groups.privilege">
        <field name="name">Stock Control (Maker / Checker)</field>
        <field name="category_id" ref="module_category_littlerides"/>
        <field name="sequence">10</field>
    </record>
    <record id="group_lr_stock_maker" model="res.groups">
        <field name="name">Maker: records counts, rejects and transfers</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="privilege_lr_stock"/>
        <field name="implied_ids" eval="[(4, ref('stock.group_stock_user'))]"/>
    </record>
    <record id="group_lr_stock_checker" model="res.groups">
        <field name="name">Checker: approves stock plus or minus</field>
        <field name="sequence">20</field>
        <field name="privilege_id" ref="privilege_lr_stock"/>
        <field name="implied_ids" eval="[(4, ref('group_lr_stock_maker'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>

    <!-- Journal voucher checker -->
    <record id="privilege_lr_voucher" model="res.groups.privilege">
        <field name="name">Journal Vouchers</field>
        <field name="category_id" ref="module_category_littlerides"/>
        <field name="sequence">20</field>
    </record>
    <record id="group_lr_voucher_checker" model="res.groups">
        <field name="name">Checker: posts manual journal entries</field>
        <field name="privilege_id" ref="privilege_lr_voucher"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>

    <!-- Salesperson sees only own customers -->
    <record id="privilege_lr_customers" model="res.groups.privilege">
        <field name="name">Customer Visibility</field>
        <field name="category_id" ref="module_category_littlerides"/>
        <field name="sequence">30</field>
    </record>
    <record id="group_lr_own_customers" model="res.groups">
        <field name="name">Own customers only</field>
        <field name="privilege_id" ref="privilege_lr_customers"/>
    </record>

    <record id="rule_partner_own_customers" model="ir.rule">
        <field name="name">Little Rides: salesperson sees own and unassigned customers</field>
        <field name="model_id" ref="base.model_res_partner"/>
        <field name="groups" eval="[(4, ref('group_lr_own_customers'))]"/>
        <field name="domain_force">['|', '|', ('customer_rank', '=', 0), ('user_id', '=', user.id), ('user_id', '=', False)]</field>
    </record>
</odoo>
