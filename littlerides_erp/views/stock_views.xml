<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_picking_form_lr" model="ir.ui.view">
        <field name="name">stock.picking.form.littlerides</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='origin']" position="after">
                <field name="lr_channel" invisible="not lr_channel"/>
                <field name="lr_transport_mode" invisible="picking_type_code != 'outgoing'"/>
                <field name="lr_vehicle_id" invisible="lr_transport_mode != 'own_truck'"/>
                <field name="lr_driver_id" invisible="not lr_vehicle_id"/>
            </xpath>
        </field>
    </record>

    <record id="vpicktree_lr" model="ir.ui.view">
        <field name="name">stock.picking.list.littlerides</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.vpicktree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='origin']" position="after">
                <field name="lr_channel" optional="show"/>
                <field name="lr_vehicle_id" optional="hide"/>
            </xpath>
        </field>
    </record>

    <record id="view_picking_search_lr" model="ir.ui.view">
        <field name="name">stock.picking.search.littlerides</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_internal_search"/>
        <field name="arch" type="xml">
            <xpath expr="//search" position="inside">
                <separator/>
                <filter name="lr_single" string="Single Piece" domain="[('lr_channel', '=', 'offline_single')]"/>
                <filter name="lr_bulk" string="Bulk / Dealer" domain="[('lr_channel', '=', 'offline_bulk')]"/>
                <filter name="lr_marketplace" string="Marketplace" domain="[('lr_channel', 'in', ('amazon', 'flipkart'))]"/>
                <group>
                    <filter name="groupby_lr_channel" string="Sales Channel" context="{'group_by': 'lr_channel'}"/>
                </group>
            </xpath>
        </field>
    </record>

    <!-- Checker queues -->
    <record id="action_lr_counts_to_approve" model="ir.actions.act_window">
        <field name="name">Stock Counts to Approve</field>
        <field name="res_model">stock.quant</field>
        <field name="view_mode">list</field>
        <field name="view_id" ref="stock.view_stock_quant_tree_inventory_editable"/>
        <field name="domain">[('inventory_quantity_set', '=', True)]</field>
        <field name="context">{'inventory_mode': True}</field>
    </record>
    <record id="action_lr_scraps_to_approve" model="ir.actions.act_window">
        <field name="name">Rejects and Scrap to Approve</field>
        <field name="res_model">stock.scrap</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('state', '=', 'draft')]</field>
    </record>
    <record id="action_lr_vouchers_to_post" model="ir.actions.act_window">
        <field name="name">Journal Vouchers to Post</field>
        <field name="res_model">account.move</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="account.view_move_tree"/>
        <field name="domain">[('move_type', '=', 'entry'), ('state', '=', 'draft'), ('journal_id.type', '=', 'general')]</field>
        <field name="context">{'default_move_type': 'entry'}</field>
    </record>
</odoo>
