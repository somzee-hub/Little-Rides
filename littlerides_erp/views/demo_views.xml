<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_lr_demo_manager_form" model="ir.ui.view">
        <field name="name">lr.demo.manager.form</field>
        <field name="model">lr.demo.manager</field>
        <field name="arch" type="xml">
            <form string="Demo Data" create="0" delete="0">
                <header>
                    <button name="action_load" type="object" string="Load Demo Data" class="btn-primary"
                            invisible="state == 'loaded'"
                            confirm="Load the Little Rides demo data? Products, BoMs, orders and stock will be created."/>
                    <button name="action_unload" type="object" string="Remove Demo Data" class="btn-danger"
                            invisible="state != 'loaded'"
                            confirm="Remove all Little Rides demo data? Orders, invoices, stock moves, products and partners created by the demo will be deleted. Your own records, users, warehouses and settings stay."/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>Little Rides Demo Data</h1>
                    </div>
                    <group>
                        <field name="state" widget="badge" decoration-success="state == 'loaded'"/>
                        <field name="loaded_on" invisible="state != 'loaded'" string="Loaded On (UTC)"/>
                        <field name="record_count" invisible="state != 'loaded'" string="Records Created"/>
                    </group>
                    <field name="summary" invisible="not summary"/>
                    <p class="text-muted">
                        Demo data covers granule purchases, moulding with regrind, transfer of parts to Alipur,
                        assembly of B8, 7373 and 2188, dealer and marketplace orders, spare-part sales,
                        trucks, and entries waiting for a checker. Removing it deletes only what the demo created.
                        Users, warehouses, work centres, price lists and settings stay in place.
                    </p>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_lr_demo_open" model="ir.actions.server">
        <field name="name">Demo Data</field>
        <field name="model_id" ref="model_lr_demo_manager"/>
        <field name="state">code</field>
        <field name="code">action = model.action_open()</field>
        <field name="group_ids" eval="[(4, ref('base.group_system'))]"/>
    </record>
</odoo>
