<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_order_form_lr" model="ir.ui.view">
        <field name="name">sale.order.form.littlerides</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='payment_term_id']" position="after">
                <field name="lr_channel" readonly="state in ['cancel', 'sale']"/>
                <field name="lr_transport_mode"/>
                <field name="lr_stock_status" widget="badge"
                       decoration-success="lr_stock_status == 'green'"
                       decoration-warning="lr_stock_status == 'amber'"
                       decoration-danger="lr_stock_status == 'red'"
                       invisible="not lr_stock_status"/>
            </xpath>
            <xpath expr="//field[@name='order_line']/list/field[@name='product_uom_qty']" position="after">
                <field name="lr_stock_signal" widget="badge" optional="show"
                       decoration-success="lr_stock_signal == 'green'"
                       decoration-warning="lr_stock_signal == 'amber'"
                       decoration-danger="lr_stock_signal == 'red'"/>
                <field name="lr_stock_note" optional="show"/>
            </xpath>
        </field>
    </record>

    <record id="sale_order_tree_lr" model="ir.ui.view">
        <field name="name">sale.order.list.littlerides</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.sale_order_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='amount_total']" position="before">
                <field name="lr_channel" optional="show"/>
                <field name="lr_stock_status" widget="badge" optional="show"
                       decoration-success="lr_stock_status == 'green'"
                       decoration-warning="lr_stock_status == 'amber'"
                       decoration-danger="lr_stock_status == 'red'"/>
            </xpath>
        </field>
    </record>

    <record id="view_sales_order_filter_lr" model="ir.ui.view">
        <field name="name">sale.order.search.littlerides</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_sales_order_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//search" position="inside">
                <separator/>
                <filter name="lr_offline" string="Offline" domain="[('lr_channel', 'in', ('offline_bulk', 'offline_single'))]"/>
                <filter name="lr_online" string="Online" domain="[('lr_channel', 'in', ('amazon', 'flipkart', 'website'))]"/>
                <group>
                    <filter name="groupby_lr_channel" string="Sales Channel" context="{'group_by': 'lr_channel'}"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
