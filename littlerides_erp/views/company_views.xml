<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_company_form_lr" model="ir.ui.view">
        <field name="name">res.company.form.littlerides</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Little Rides" name="littlerides">
                    <group>
                        <group string="Stock by channel">
                            <field name="lr_factory_warehouse_id"/>
                            <field name="lr_offline_warehouse_id"/>
                            <field name="lr_online_warehouse_id"/>
                        </group>
                        <group string="Alerts">
                            <field name="lr_production_head_id"/>
                            <field name="lr_purchase_head_id"/>
                            <field name="lr_cover_safety_days"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
